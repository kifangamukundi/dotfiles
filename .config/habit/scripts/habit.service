[Unit]
Description=habit - Personal Site Blocker DNS Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Path to the binary and config
ExecStart=/usr/local/bin/habit --config /etc/habit/config.yaml
Restart=always
RestartSec=5
User=habit
Group=habit

# Security Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
# Allow writing to the cache directory
ReadWritePaths=/var/lib/habit
ReadOnlyPaths=/etc/habit

# Capability to bind to port 53 without being root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
